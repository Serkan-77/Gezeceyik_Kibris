# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored (see .gitignore's `.env*` rule) — never commit
# real credentials.

# Supabase project URL (Dashboard → Project Settings → API → Project URL).
# Format: https://<project-ref>.supabase.co
# See docs/SUPABASE_SETUP_GUIDE.md for how to obtain this and set up the
# database schema.
SUPABASE_URL=

# Supabase service role key (Dashboard → Project Settings → API → service_role
# secret key). This key bypasses Row Level Security — it is used server-side
# only (see src/lib/db/supabase.ts) and must NEVER be exposed to the browser
# or committed. Do not confuse it with the "anon public" key.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production URL, used for metadataBase, sitemap.xml, and robots.txt.
# Required in production builds — src/lib/config.ts throws if it's unset and
# NODE_ENV=production, so a deploy can't silently ship pointing at localhost.
NEXT_PUBLIC_SITE_URL=

# Shared password for the /admin panel (single-operator, no user accounts).
# Required for /admin to work at all — see src/lib/admin/session.ts.
# Pick a long random value; never reuse a password from elsewhere.
ADMIN_PASSWORD=

# Optional. Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Leave unset to disable analytics entirely — src/components/layout/Analytics.tsx
# renders nothing until this is set. Create a free GA4 property at
# https://analytics.google.com to get one.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
